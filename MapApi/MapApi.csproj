<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyTitle>企业地图接口平台</AssemblyTitle>
    <Description>面向企业内部的统一地图接口平台，聚合多地图厂商能力并提供标准化地理服务访问入口</Description>
    <Company>新生命开发团队</Company>
    <Copyright>©2002-2026 新生命开发团队</Copyright>
    <VersionPrefix>1.1</VersionPrefix>
    <VersionSuffix>$([System.DateTime]::Now.ToString(`yyyy.MMdd`))</VersionSuffix>
    <Version>$(VersionPrefix).$(VersionSuffix)</Version>
    <FileVersion>$(Version)</FileVersion>
    <AssemblyVersion>$(VersionPrefix).*</AssemblyVersion>
    <Deterministic>false</Deterministic>
    <OutputPath>..\Bin\MapApi</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Areas\Location\Controllers\GeoController.cs" />
    <Compile Remove="Locations\地理数据.Biz.cs" />
    <Compile Remove="Locations\地理数据.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NewLife.Cube.Core" Version="6.15.2026.1017-beta1435" />
    <PackageReference Include="NewLife.IP" Version="2.5.2026.1017-beta1408" />
    <PackageReference Include="NewLife.Stardust.Extensions" Version="3.10.2026.1017-beta1056" />
    <PackageReference Include="NewLife.XCode" Version="12.2.2026.1017-beta1246" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.Map\NewLife.Map.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Locales 目录由 NewLife.Core 源生成器编译期解析；本项目未直接引用 Core 包，显式挂载输入 -->
    <AdditionalFiles Include="$(MSBuildProjectDirectory)\Locales\*.yml" />
  </ItemGroup>
</Project>
