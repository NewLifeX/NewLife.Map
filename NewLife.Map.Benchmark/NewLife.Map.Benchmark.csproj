<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyTitle>地图组件基准测试</AssemblyTitle>
    <Description>BenchmarkDotNet 基准测试：批量坐标转换性能对比</Description>
    <OutputPath>..\Bin\Benchmark</OutputPath>
    <!-- 被测项目 NewLife.Map 使用通配符 AssemblyVersion，需关闭确定性以避免 BenchmarkDotNet 生成项目编译冲突 -->
    <Deterministic>false</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NewLife.Map\NewLife.Map.csproj" />
  </ItemGroup>

</Project>
